# Copy to .env and adjust. .env is gitignored.

# PostgreSQL (Docker: `docker compose up -d` at the repo root)
DATABASE_URL=postgresql+asyncpg://aurora:aurora@localhost:5432/aurora

# Redis (same compose file)
REDIS_URL=redis://localhost:6379/0

# Signing key for access tokens. REQUIRED — the app refuses to start without it.
AURORA_JWT_SECRET=dev-secret-change-in-production
AURORA_JWT_EXPIRY_DAYS=7

# Comma-separated list of allowed browser origins
AURORA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# ROI grid (rarely overridden — the shape (101, 361) is frozen by the model)
# ---------------------------------------------------------------------------
ROI_LON_MIN=-10.125
ROI_LAT_MIN=-75.125
ROI_LON_MAX=80.125
ROI_LAT_MAX=-49.875

# Projection used when rendering SIC frames for the map
LCC_PROJ=+proj=lcc +lat_1=-45 +lat_2=-65 +lat_0=-55 +lon_0=35 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs

# Root of the runtime data tree (fields, sic_frames, sic_arrays). Gitignored.
STORAGE_ROOT=./data

# ---------------------------------------------------------------------------
# Data source credentials — ALL OPTIONAL.
# An adapter with no credentials logs "not configured" and returns nothing.
# It never fabricates a field. Configure only what you have access to.
# ---------------------------------------------------------------------------

# NSIDC CDR v6 sea ice concentration (daily, 25 km, EPSG:3976)
# https://nsidc.org/data/user-services/help/create-account
NSIDC_USERNAME=
NSIDC_PASSWORD=

# Copernicus Climate Data Store — ERA5 / ERA5T surface fields
# https://cds.climate.copernicus.eu/api-how-to  (URL is your key line)
CDSAPI_URL=
CDSAPI_KEY=

# Copernicus Marine Service — GLORYS12V1 global reanalysis
# https://marine.copernicus.eu/  (Settings > My settings > Generate token)
CMEMS_USERNAME=
CMEMS_PASSWORD=

# AISStream.io WebSocket relay (PART 2 — real-time AIS)
AISSTREAM_API_KEY=

# BYU Sea Ice Change Program iceberg listings (daily scrape)
# e.g. https://scp.byu.edu/iceberg_listings/recent_icebergs.php
BYU_SCP_URL=

# Ship GPS feed over TCP/UDP (PART 2 — NMEA sentences)
GPS_HOST=
GPS_PORT=

# ---------------------------------------------------------------------------
# Forecaster (vendored at AURORA/forecaster/, installed `pip install -e`)
# ---------------------------------------------------------------------------
SIC_ARTIFACTS_PATH=../forecaster/artifacts
FORECASTER_MAX_STALENESS_DAYS=7
FORECASTER_DEGRADED_DAYS=10
STALENESS_PENALTY_PER_DAY=0.05

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
# Hour of day (UTC) for the daily SIC forecast cycle
DAILY_JOB_HOUR=3
