# Copy to .env and adjust. .env is gitignored.

# PostgreSQL (Docker: `docker compose up -d` at the repo root)
DATABASE_URL=postgresql+asyncpg://aurora:aurora@localhost:5432/aurora

# Redis (same compose file)
REDIS_URL=redis://localhost:6379/0

# Signing key for access tokens. REQUIRED — the app refuses to start without it.
AURORA_JWT_SECRET=dev-secret-change-in-production
AURORA_JWT_EXPIRY_DAYS=7

# Comma-separated list of allowed browser origins
AURORA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# ROI grid (rarely overridden — the shape (101, 361) is frozen by the model)
# ---------------------------------------------------------------------------
ROI_LON_MIN=-10.125
ROI_LAT_MIN=-75.125
ROI_LON_MAX=80.125
ROI_LAT_MAX=-49.875

# Projection used when rendering SIC frames for the map
LCC_PROJ=+proj=lcc +lat_1=-45 +lat_2=-65 +lat_0=-55 +lon_0=35 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs

# Root of the runtime data tree (fields, sic_frames, sic_arrays). Gitignored.
STORAGE_ROOT=./data

# ---------------------------------------------------------------------------
# Data source credentials — ALL OPTIONAL.
# An adapter with no credentials logs "not configured" and returns nothing.
# It never fabricates a field. Configure only what you have access to.
# ---------------------------------------------------------------------------

# NSIDC CDR v6 sea ice concentration (daily, 25 km, EPSG:3976)
# https://nsidc.org/data/user-services/help/create-account
NSIDC_USERNAME=
NSIDC_PASSWORD=

# Copernicus Climate Data Store — ERA5 / ERA5T surface fields
# https://cds.climate.copernicus.eu/api-how-to  (URL is your key line)
CDSAPI_URL=
CDSAPI_KEY=

# Copernicus Marine Service — GLORYS12V1 global reanalysis
# https://marine.copernicus.eu/  (Settings > My settings > Generate token)
CMEMS_USERNAME=
CMEMS_PASSWORD=

# AISStream.io WebSocket relay (PART 2 — real-time AIS)
AISSTREAM_API_KEY=

# BYU Sea Ice Change Program iceberg listings (daily scrape)
# e.g. https://scp.byu.edu/iceberg_listings/recent_icebergs.php
BYU_SCP_URL=

# Ship GPS feed over TCP/UDP (PART 2 — NMEA sentences)
GPS_HOST=
GPS_PORT=

# ---------------------------------------------------------------------------
# Forecaster (vendored at AURORA/forecaster/, installed `pip install -e`)
# ---------------------------------------------------------------------------
SIC_ARTIFACTS_PATH=../forecaster/artifacts
FORECASTER_MAX_STALENESS_DAYS=7
FORECASTER_DEGRADED_DAYS=10
STALENESS_PENALTY_PER_DAY=0.05

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
# Hour of day (UTC) for the daily SIC forecast cycle
DAILY_JOB_HOUR=3


# ---------------------------------------------------------------------------
# Route optimizer (PART 2)
# ---------------------------------------------------------------------------
# Under-keel clearance required below the keel, metres
ROUTE_UKC_MARGIN_M=2.0
ROUTE_WEIGHT_ICE=1.0
ROUTE_WEIGHT_THICKNESS=1.5
ROUTE_WEIGHT_ICEBERG=2.0
ROUTE_WEIGHT_WEATHER=0.5
ROUTE_WEIGHT_FUEL=1.0
ROUTE_WEIGHT_CURRENT=0.3
# Comma-separated UTC hours for the 6-hourly route job
ROUTE_JOB_HOURS=0,6,12,18
# Default departure (Cape Town) and destinations "lat,lon;lat,lon"
DEFAULT_DEPARTURE_LAT=-33.9
DEFAULT_DEPARTURE_LON=18.4
DEFAULT_DESTINATIONS=-70.767,11.733;-69.397,76.247
# Alarm thresholds not carried on the vessel blueprint
ALARM_CPA_NM=1.0
ALARM_OFF_COURSE_NM=2.0
ALARM_ICEBERG_NM=20.0
ALARM_STALENESS_HOURS=36

# ---------------------------------------------------------------------------
# Storage and retention (PART 2)
# ---------------------------------------------------------------------------
# Days of data/sic_frames/<date>/ to keep
SIC_FRAMES_RETENTION_DAYS=30
# Hour of day (UTC) for the daily cleanup job
CLEANUP_JOB_HOUR=4
# Warn in the cleanup log when either of these is exceeded, MB
WARN_SIC_FRAMES_MB=500
WARN_FIELDS_MB=2000

# ---------------------------------------------------------------------------
# Real-time relays (PART 2)
# ---------------------------------------------------------------------------
# Vessel row the GPS and AIS relays publish against
OWN_SHIP_VESSEL_ID=1
# An AIS sighting older than this stops being a live target, minutes
AIS_FRESHNESS_MINUTES=30
# Seconds between weather samples at the vessel position
WEATHER_POLL_SECONDS=300
# Seconds between alarm-engine passes
ALARM_POLL_SECONDS=60
# Seconds to wait before reconnecting to a dead relay socket
RELAY_RECONNECT_SECONDS=10
# Hours an alarm stays muted after it is acknowledged
ALARM_REARM_HOURS=1