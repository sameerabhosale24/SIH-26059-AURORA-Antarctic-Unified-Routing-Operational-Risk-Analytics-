# AURORA frontend — environment configuration
# Copy this file to `.env` and adjust for your backend.
#
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows cmd / PowerShell)
#
# Both variables are REQUIRED. src/config/env.ts throws at startup if either
# is missing or malformed.

# Base URL for the REST API (no trailing slash)
VITE_API_BASE=http://localhost:8000

# Base URL for WebSocket streams (no trailing slash, ws:// or wss://)
VITE_WS_BASE=ws://localhost:8000
